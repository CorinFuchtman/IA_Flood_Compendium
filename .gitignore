zipped_data/

# Python bytecode cache
__pycache__/
*.pyc

# Editor and assistant settings (personal, machine-specific)
.vscode/
.idea/
.claude/

# Local, regeneratable pipeline caches -- see the scripts in pipeline/ to
# rebuild any of these (MRMS and FLASH hourly grids, the ownCloud sensor
# archive, per-episode extracts, the USGS high water mark archive, the imagery
# overpass query cache).
cache/
pipeline/*.log
pipeline/*_log.txt

# RMA cause-of-loss raw files pulled manually from RMA's site (see
# pipeline/episode_rma_extract.py)
data/support/rma_cause_of_loss/raw/

# Site build outputs: wizard.html is the pre-publish page written by
# build_wizard_html.py; the published copy lives in docs/index.html.
data/site_build/wizard.html
data/site_build/embedded_episode_data.b64.txt
data/site_build/preview_*.html
data/site_build/sensors_by_huc8.geojson
data/site_build/sensors_by_county.geojson
data/site_build/sensor_points.geojson

# Impacts module: downloaded gazetteer cache
data/impacts/census_gazetteer_places_ia.txt
